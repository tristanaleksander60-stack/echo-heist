local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local INDEX: { [string]: number } = {}
for i = 1, #ALPHABET do
	INDEX[string.sub(ALPHABET, i, i)] = i - 1
end

-- Base64 text -> buffer (the generator writes valid text).
function GhostTapes.decode64(text: string): buffer
	local pad = #(string.match(text, "=*$") or "")
	local n = #text // 4 * 3 - pad
	local buf = buffer.create(n)
	local o = 0
	for i = 1, #text, 4 do
		local v = 0
		for k = 0, 3 do
			v = v * 64 + (INDEX[string.sub(text, i + k, i + k)] or 0)
		end
		for k = 2, 0, -1 do
			if o < n then
				buffer.writeu8(buf, o, bit32.band(bit32.rshift(v, 8 * k), 255))
				o += 1
			end
		end
	end
	return buf
end

-- The steps of a level (nil: no ghost for it).
function GhostTapes.steps(levelId: string): { Step }?
	return GhostTapes.LEVELS[levelId]
end

-- Step k's recording as a buffer (Rec/Codec.decode it).
function GhostTapes.buffer(levelId: string, k: number): buffer?
	local steps = GhostTapes.LEVELS[levelId]
	local step = steps and steps[k]
	return if step then GhostTapes.decode64(step.tape) else nil
end

return GhostTapes
