--!strict
-- Audio/Manifest: every asset id the cue table (Audio/Cues) may use, with what the Roblox Creator Store said
-- about it. GENERATED 2026-11-12 from real API responses (docs/AUDIO.md "Sourcing"): ids came from
--   GET https://apis.roblox.com/toolbox-service/v1/marketplace/3?keyword=...&creatorTargetId=<id>&creatorType=1
-- and every row below from
--   GET https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=...
-- Never add an id by hand that did not come back from one of those calls (or from the owner's own upload).
-- "seconds" is the store's rounded duration. Creators: APMOfficial (APM Music, Roblox's music partner) and
-- ProSoundEffects (Pro Sound Effects, Roblox's SFX partner): audio "owned and uploaded by Roblox or our music
-- and SFX partners will remain public and usable by anyone in any experience" (DevForum 1701697). Roblox-only:
-- never download, re-upload or use these files off-platform (trailers and TikToks use owned music).

export type Entry = {
	creator: string,
	creatorId: number,
	title: string,
	seconds: number,
	kind: string, -- "SoundEffect" | "Music" | "Unknown" (the store's audioType)
	artist: string,
	album: string,
	uploaded: string, -- UTC date the asset was created
}

