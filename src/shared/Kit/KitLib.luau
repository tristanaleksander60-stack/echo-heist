--!strict
-- Kit/KitLib: pure helpers for the art kit (spike S2, automated path; docs/art/KIT_IMPORT.md).
-- No services, no clocks: KitService (src/server/Kit) feeds it plain data and instances, and the
-- Lune specs (tests/unit/KitLib.spec.luau) run it headless.
--
-- The kit data (src/server/Kit/KitData.luau) is generated by tools/kit_upload.py from
-- assets/fbx/kit_manifest.json (sizes, bounds, flags) and assets/kit_ids.json (Open Cloud asset ids).

local KitLib = {}

export type Vec = { number } -- { x, y, z } in Roblox axes (Y up, front -Z)

export type PartSpec = {
	model: string,
	size: Vec,
	boundsMin: Vec,
	boundsMax: Vec,
	origin: Vec,
	collision: string,
	material: string,
	canCollide: boolean,
	castShadow: boolean,
	atlas: boolean,
	layer: string,
	color: string?,
	transparency: number?,
	texture: string?,
	tintable: boolean?,
	-- BLENDER LOOK: an inverted-hull outline (assets/blender/zz_outlines.py) of the piece `outlineOf`;
	-- outlineClass "char" | "hero" | "loot" (Config.Outline.TIERS)
	outlineOf: string?,
	outlineClass: string?,
}

export type KitData = {
	parts: { [string]: PartSpec },
	assets: { [string]: number },
	images: { [string]: { decal: number, image: number? } },
	atlases: { [string]: string },
	appearances: number?, -- Model asset of pre-built hero SurfaceAppearances (tools/kit_upload.py --appearances)
}

-- What a level may ask a MeshPart for. Runtime cannot change CollisionFidelity (it is baked when
-- the part is made), so KitService rebuilds parts whose fidelity differs (AssetService:CreateMeshPartAsync).
KitLib.FIDELITIES = {
	Default = true,
	Box = true,
	Hull = true,
	PreciseConvexDecomposition = true,
}
KitLib.MATERIALS = {
	SmoothPlastic = true,
	Neon = true,
	Glass = true,
}

-- A bare number (or numeric string) becomes rbxassetid://<n>; a URI is kept; empty stays empty.
function KitLib.uri(id: (string | number)?): string
	if id == nil then
		return ""
	end
	if type(id) == "number" then
		return if id > 0 then "rbxassetid://" .. string.format("%d", id) else ""
	end
	local s = string.match(id, "^%s*(.-)%s*$") or ""
	if string.match(s, "^%d+$") then
		return "rbxassetid://" .. s
	end
	return s
end

-- "#RRGGBB" -> r, g, b in 0..1 (nil for anything else).
function KitLib.hex(hex: string): (number?, number?, number?)
	local r, g, b = string.match(hex, "^#?(%x%x)(%x%x)(%x%x)$")
	if r == nil or g == nil or b == nil then
		return nil, nil, nil
	end
	return (tonumber(r, 16) :: number) / 255, (tonumber(g, 16) :: number) / 255, (tonumber(b, 16) :: number) / 255
end

-- { model -> sorted piece names }, every model sorted too (stable boot order).
function KitLib.groups(parts: { [string]: PartSpec }): ({ [string]: { string } }, { string })
	local groups: { [string]: { string } } = {}
	local order: { string } = {}
	for name, spec in parts do
		local list = groups[spec.model]
		if list == nil then
			list = {}
			groups[spec.model] = list
			table.insert(order, spec.model)
		end
		table.insert(list, name)
	end
	for _, list in groups do
		table.sort(list)
	end
	table.sort(order)
	return groups, order
end

-- The boot phases over `order` (KitLib.groups): the priority groups (a name starting with one of `prefixes`: the
-- Rookie, every first spawn waits for it), then the intro's groups (`introGroups`, exact names, not already in the
-- first phase), then the rest. Each list keeps `order`'s order; a group is in exactly one list.
function KitLib.phases(
	order: { string },
	prefixes: { string }?,
	introGroups: { string }?
): ({ string }, { string }, { string })
	local intro: { [string]: boolean } = {}
	for _, name in introGroups or {} do
		intro[name] = true
	end
	local first, second, rest = {}, {}, {}
	for _, model in order do
		local isFirst = false
		for _, prefix in prefixes or {} do
			if string.sub(model, 1, #prefix) == prefix then
				isFirst = true
				break
			end
		end
		table.insert(if isFirst then first elseif intro[model] then second else rest, model)
	end
	return first, second, rest
end

-- Name map of kit pieces among `items` (any instance-like values with .Name and :IsA). Only
-- MeshParts count: an uploaded group nests Model > Model > MeshPart and many MeshParts share
-- their Model's name (CashBag in CashBag), so a recursive FindFirstChild(name, true) can return
-- the Model. Duplicates keep the first and are listed.
function KitLib.nameMap(items: { any }): ({ [string]: any }, { string })
	local map: { [string]: any } = {}
	local dups: { string } = {}
	for _, item in items do
		if item:IsA("MeshPart") then
			local name = item.Name :: string
			if map[name] == nil then
				map[name] = item
			else
				table.insert(dups, name)
			end
		end
	end
	return map, dups
end

-- Which pieces of a group were found, which are missing, which loaded names the manifest
-- does not know (an old or renamed piece).
function KitLib.matchGroup(want: { string }, found: { [string]: any }): ({ string }, { string })
	local missing: { string } = {}
	local known: { [string]: boolean } = {}
	for _, name in want do
		known[name] = true
		if found[name] == nil then
			table.insert(missing, name)
		end
	end
	local extra: { string } = {}
	for name in found do
		if not known[name] then
			table.insert(extra, name)
		end
	end
	table.sort(extra)
	return missing, extra
end

-- Largest per-axis difference between a size and the manifest size.
function KitLib.sizeError(x: number, y: number, z: number, want: Vec): number
	return math.max(math.abs(x - want[1]), math.abs(y - want[2]), math.abs(z - want[3]))
end

-- The part's bounding-box centre relative to its pivot (the kit point), from the manifest bounds.
function KitLib.center(spec: PartSpec): Vec
	local lo, hi = spec.boundsMin, spec.boundsMax
	return { (lo[1] + hi[1]) / 2, (lo[2] + hi[2]) / 2, (lo[3] + hi[3]) / 2 }
end

-- PivotOffset position (the pivot relative to the part's centre). Its rotation is always identity:
-- uploaded MeshParts arrive with a rotated PivotOffset basis (Z-up to Y-up), which KitService resets.
function KitLib.pivotOffset(spec: PartSpec): Vec
	local c = KitLib.center(spec)
	return { -c[1], -c[2], -c[3] }
end

-- Where the part's centre sits in its model's scene space (Insert Using Scene Position): origin + centre.
-- An imported part away from this means the FBX axis conversion changed.
function KitLib.scenePosition(spec: PartSpec): Vec
	local c = KitLib.center(spec)
	local o = spec.origin
	return { o[1] + c[1], o[2] + c[2], o[3] + c[3] }
end

-- The CollisionFidelity a piece gets in game: its manifest value only for the pieces the game
-- uses as colliders (`colliders`, Config.Kit.COLLIDER_PIECES: the swapped door leaf, shutter and
-- plate); every other piece is visual only (KitDresser: CanCollide, CanQuery, CanTouch off), so
-- it carries Box data instead of precise decomposition it would never use.
function KitLib.gameCollision(name: string, spec: PartSpec, colliders: { [string]: boolean }?): string
	if spec.outlineOf ~= nil then
		return "Default" -- an outline hull never collides or queries: kept as uploaded, no rebuild at boot
	end
	if colliders == nil or colliders[name] then
		return spec.collision
	end
	return "Box"
end

-- The RenderFidelity a piece is built with (docs/audit/STUDIO_FIDELITY.md): "Precise" for the hero pieces whose
-- names start with one of `prefixes` (Config.Kit.PRECISE_PREFIXES: the characters, the vault door, the skyline
-- seen from far away), "Automatic" (full detail under ~250 studs, the engine's LoDs beyond) for everything else.
function KitLib.renderFidelity(name: string, prefixes: { string }?): string
	if KitLib.isOutlineName(name) then
		return "Automatic" -- outline hulls keep the upload's (no rebuild); full detail where a line is visible
	end
	for _, p in prefixes or {} do
		if string.sub(name, 1, #p) == p then
			return "Precise"
		end
	end
	return "Automatic"
end

-- BLENDER LOOK: outline hulls are named `<Piece>_Outline` (assets/blender/zz_outlines.py).
KitLib.OUTLINE_SUFFIX = "_Outline"
KitLib.OUTLINE_TAG = "EH_Outline" -- CollectionService tag on every attached hull (Heist/Outlines finds them)

function KitLib.isOutlineName(name: string): boolean
	local n = #KitLib.OUTLINE_SUFFIX
	return #name > n and string.sub(name, -n) == KitLib.OUTLINE_SUFFIX
end

-- A hull's Size for an outline thickness scale (Config.Outline.THICKNESS_SCALE): the piece's size plus the built
-- margin (hull - piece, per axis) times `scale`. scale 1 = the built size.
function KitLib.outlineSize(piece: Vec, hull: Vec, scale: number): Vec
	return {
		piece[1] + (hull[1] - piece[1]) * scale,
		piece[2] + (hull[2] - piece[2]) * scale,
		piece[3] + (hull[3] - piece[3]) * scale,
	}
end

-- {piece -> hull name} for every outline in the kit data.
function KitLib.outlines(parts: { [string]: PartSpec }): { [string]: string }
	local out = {}
	for name, spec in parts do
		if spec.outlineOf then
			out[spec.outlineOf] = name
		end
	end
	return out
end

-- Does a loaded part need a rebuild for its CollisionFidelity? mode: "all" | "colliding" | "none".
function KitLib.needsRebuild(current: string, spec: PartSpec, mode: string): boolean
	if current == spec.collision or mode == "none" then
		return false
	end
	if mode == "colliding" then
		return spec.canCollide
	end
	return true
end

-- The atlas image to use for a location: the override, else the uploaded image, else the
-- fallback (the first atlas texture the FBX importer made). Returns the URI and where it came from.
function KitLib.atlasUri(
	location: string,
	overrides: { [string]: string },
	data: KitData,
	fallback: string
): (string, string)
	local override = KitLib.uri(overrides[location])
	if override ~= "" then
		return override, "Config.Kit.Atlas." .. location
	end
	local file = data.atlases[location]
	local img = if file then data.images[file] else nil
	if img and img.image then
		return KitLib.uri(img.image), "uploaded " .. (file :: string)
	end
	return fallback, "imported FBX texture"
end

local function isVec(v: any): boolean
	if type(v) ~= "table" or #v ~= 3 then
		return false
	end
	for i = 1, 3 do
		if type(v[i]) ~= "number" or v[i] ~= v[i] then
			return false
		end
	end
	return true
end

-- Problems in the generated data (empty when it is usable). requireIds: every group must have an asset id.
function KitLib.validate(data: KitData, requireIds: boolean): { string }
	local problems: { string } = {}
	local function bad(msg: string)
		table.insert(problems, msg)
	end
	local count = 0
	for name, spec in data.parts do
		count += 1
		if type(spec.model) ~= "string" or spec.model == "" then
			bad(name .. ": no model")
		end
		if not isVec(spec.size) then
			bad(name .. ": size is not 3 numbers")
		elseif spec.size[1] <= 0 or spec.size[2] <= 0 or spec.size[3] <= 0 then
			bad(name .. ": size must be positive")
		end
		if not (isVec(spec.boundsMin) and isVec(spec.boundsMax) and isVec(spec.origin)) then
			bad(name .. ": boundsMin/boundsMax/origin must be 3 numbers")
		elseif isVec(spec.size) then
			for i = 1, 3 do
				local extent = spec.boundsMax[i] - spec.boundsMin[i]
				if math.abs(extent - spec.size[i]) > 0.01 then
					bad(string.format("%s: bounds axis %d spans %.3f but size is %.3f", name, i, extent, spec.size[i]))
				end
			end
		end
		if not KitLib.FIDELITIES[spec.collision] then
			bad(name .. ": unknown collision " .. tostring(spec.collision))
		end
		if not KitLib.MATERIALS[spec.material] then
			bad(name .. ": unknown material " .. tostring(spec.material))
		end
		if
			type(spec.canCollide) ~= "boolean"
			or type(spec.castShadow) ~= "boolean"
			or type(spec.atlas) ~= "boolean"
		then
			bad(name .. ": canCollide/castShadow/atlas must be booleans")
		end
		if spec.color ~= nil and KitLib.hex(spec.color) == nil then
			bad(name .. ": color is not #RRGGBB")
		end
		if spec.transparency ~= nil and (spec.transparency < 0 or spec.transparency >= 1) then
			bad(name .. ": transparency out of 0..1")
		end
	end
	if count == 0 then
		bad("no parts")
	end
	local groups = KitLib.groups(data.parts)
	for model in groups do
		local id = data.assets[model]
		if id == nil then
			if requireIds then
				bad(model .. ": no asset id (run python3 tools/kit_upload.py --all)")
			end
		elseif type(id) ~= "number" or id <= 0 or id ~= math.floor(id) then
			bad(model .. ": bad asset id " .. tostring(id))
		end
	end
	local app = data.appearances
	if app ~= nil and (type(app) ~= "number" or app <= 0 or app ~= math.floor(app)) then
		bad("appearances: bad asset id " .. tostring(app))
	end
	for model in data.assets do
		if groups[model] == nil then
			bad(model .. ": asset id for a group the manifest does not have")
		end
	end
	table.sort(problems)
	return problems
end

return KitLib
