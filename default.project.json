{
  "name": "EchoHeist",
  "globIgnorePaths": ["**/selene.toml", "**/sim.yml", "**/*.md"],
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$properties": {
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "GlobalShadows": true,
        "ClockTime": 15,
        "GeographicLatitude": 20,
        "Brightness": 1.4,
        "ColorShift_Top": [0.588235, 0.686275, 1.0],
        "ColorShift_Bottom": [0.156863, 0.117647, 0.27451],
        "Ambient": [0.372549, 0.352941, 0.54902],
        "OutdoorAmbient": [0.45098, 0.431373, 0.647059],
        "EnvironmentDiffuseScale": 0.3,
        "EnvironmentSpecularScale": 0.4,
        "ExposureCompensation": 0.3,
        "ShadowSoftness": 0.3
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "CelestialBodiesShown": true,
          "SunTextureId": "rbxasset://sky/moon.jpg",
          "SunAngularSize": 9,
          "MoonAngularSize": 0,
          "StarCount": 0,
          "SkyboxBk": "rbxassetid://90458356352519",
          "SkyboxDn": "rbxassetid://108707070296486",
          "SkyboxFt": "rbxassetid://103394177161659",
          "SkyboxLf": "rbxassetid://99926702251753",
          "SkyboxRt": "rbxassetid://81443795822443",
          "SkyboxUp": "rbxassetid://84848570083307"
        }
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.12,
          "Color": [0.352941, 0.313725, 0.588235],
          "Decay": [0.215686, 0.176471, 0.411765],
          "Glare": 0,
          "Haze": 1.3
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 24,
          "Threshold": 1.15
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0,
          "Contrast": 0.12,
          "Saturation": 0.08,
          "TintColor": [0.941176, 0.941176, 1.0]
        }
      },
      "ColorGrading": {
        "$className": "ColorGradingEffect",
        "$properties": {
          "TonemapperPreset": "Default"
        }
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "LihFolk": {
        "$path": "src/lihfolk"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
