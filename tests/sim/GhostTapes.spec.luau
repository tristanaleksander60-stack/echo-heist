-- L2: the "Show me?" ghost's steps (src/shared/Heist/GhostTapes.luau, generated by
-- `lune run tools/ghost_tapes.luau`) must still be each story level's solution, run by run, byte
-- for byte (else rerun the tool); and a player who copies the ghost's step from a deck that
-- needs it makes the progress the step promises (Shared/Heist/Help.nextStep).

local Assert = require("../unit/Assert")
local Codec = require("../../src/shared/Rec/Codec")
local GhostTapes = require("../../src/shared/Heist/GhostTapes")
local Help = require("../../src/shared/Heist/Help")
local HeistSim = require("../../src/shared/Sim/HeistSim")
local Bot = require("./Bot")
local Harness = require("./Harness")
local Solutions = require("./Solutions")

return function(test)
	for _, n in { 2, 3, 4, 6 } do
		local level = Harness.level(n)

		test(level.id .. ": ghost tapes are the solution's runs (rerun tools/ghost_tapes.luau if not)", function()
			local sim = Harness.play(level, Solutions.planFor(level))
			local recs = {}
			for _, s in sim.players[1].deck.slots do
				table.insert(recs, s.rec)
			end
			table.insert(recs, sim.finalRecordings[1].rec)
			local steps = assert(GhostTapes.steps(level.id))
			Assert.eq(#steps, #recs, "one step per solution run")
			for k, rec in recs do
				local buf = assert(GhostTapes.buffer(level.id, k))
				Assert.eq(buffer.tostring(buf), buffer.tostring(Codec.encode(rec)), "step " .. k .. " is current")
			end
		end)

		test(level.id .. ": copying each next step from an empty deck clears the heist at par", function()
			-- A kid who taps "Show me?" before every run and copies the ghost.
			local plan = Solutions.planFor(level)
			local sim = HeistSim.new(level, { players = { 1 } })
			local hist = Harness.history()
			for _ = 1, #plan.runs + 1 do
				local deck = HeistSim.deckOf(sim, 1)
				local step = assert(Help.nextStep(level, deck.slots, level.cap), "a next step")
				Assert.truthy(HeistSim.startRun(sim) ~= nil, "run starts")
				Harness.runOnce(sim, { Bot.new(level, 1, plan.runs[step.run][1]) }, hist)
				if sim.phase == "Over" then
					break
				end
			end
			Assert.eq(sim.overReason, "Complete", "complete")
			Assert.le(HeistSim.result(sim).clonesUsed, level.par, "at par")
		end)
	end
end
