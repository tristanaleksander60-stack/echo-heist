-- L2: the G2 / CLONE_AB golden-frame clones (src/server/Heist/StagingTapes.luau, generated by
-- `lune run tools/staging_tapes.luau`). They must still be the Clone Party solution's first
-- Scenario.TAPES runs, byte for byte (else rerun the tool), and seeded into a fresh party
-- deck they must give run 1 "8 OF ME": you + 7 clones in the world at once, the Swarm event
-- for seat 1 with 8 copies, which is what the HUD stamps.

local Assert = require("../unit/Assert")
local Codec = require("../../src/shared/Rec/Codec")
local EventLog = require("../../src/shared/Sim/EventLog")
local HeistSim = require("../../src/shared/Sim/HeistSim")
local Scenario = require("../../src/shared/Heist/Scenario")
local StagingTapes = require("../../src/server/Heist/StagingTapes")
local Bot = require("./Bot")
local Harness = require("./Harness")
local Solutions = require("./Solutions")

local EV = EventLog.EV

return function(test)
	local level = Harness.level(5)

	test("staging tapes: the solution's first 7 runs, byte for byte (rerun tools/staging_tapes.luau if not)", function()
		Assert.eq(StagingTapes.LEVEL, level.id, "for the Clone Party")
		local plan = Solutions.planFor(level)
		local runs = {}
		for r = 1, Scenario.TAPES do
			runs[r] = plan.runs[r]
		end
		local sim = Harness.play(level, { runs = runs })
		local bufs = StagingTapes.buffers()
		Assert.eq(#bufs, Scenario.TAPES, "tape count")
		for i, slot in sim.players[1].deck.slots do
			Assert.eq(buffer.tostring(bufs[i]), buffer.tostring(Codec.encode(slot.rec)), "tape " .. i .. " is current")
		end
	end)

	test("staging tapes: seeded into a fresh party, run 1 is 8 OF ME", function()
		local recs = {}
		for _, buf in StagingTapes.buffers() do
			local rec = Codec.decode(buf)
			Assert.truthy(rec, "decodes")
			table.insert(recs, rec)
		end
		local sim = HeistSim.new(level, { players = { 1 } })
		Assert.truthy(HeistSim.seedDeck(sim, 1, recs), "seeded before the first run")
		Assert.eq(HeistSim.startRun(sim), 1, "run 1 starts")
		local peak = 0
		local run = Harness.runOnce(sim, { Bot.new(level, 1, { { stay = true } }) }, Harness.history(), function(s: any)
			if s.phase == "Run" then
				peak = math.max(peak, HeistSim.ofMe(s, 1))
			end
		end)
		Assert.eq(peak, 8, "you + 7 clones at once")
		Assert.eq(EventLog.count(run.log, EV.Swarm, 1, 8), 1, "Swarm: seat 1, 8 copies (the 8 OF ME stamp)")
	end)
end
