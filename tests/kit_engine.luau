-- Mirrors Config.Kit.COLLIDER_PIECES (this script is self-contained for Open Cloud runs). Kept
-- outside the generated kit-table block so tools/kit_upload.py does not drop it on regeneration.
local GAME_COLLIDERS: { [string]: boolean } = { Wall_Door_8x12_Leaf = true, Shutter_8x10 = true, Plate_4x4 = true }

local lines: { string } = {}
local fails = 0

local function line(kind: string, msg: string)
	table.insert(lines, string.format("%-5s %s", kind, msg))
end

local function check(cond: boolean, msg: string)
	if cond then
		line("ok", msg)
	else
		fails += 1
		line("FAIL", msg)
	end
end

local function sizeErr(v: Vector3, want: { number }): number
	return math.max(math.abs(v.X - want[1]), math.abs(v.Y - want[2]), math.abs(v.Z - want[3]))
end

local function isIdentity(cf: CFrame): boolean
	local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	local d = math.abs(r00 - 1) + math.abs(r11 - 1) + math.abs(r22 - 1)
	local o = math.abs(r01) + math.abs(r02) + math.abs(r10) + math.abs(r12) + math.abs(r20) + math.abs(r21)
	return d + o < 1e-3
end

local function sorted(t: { [string]: any }): { string }
	local out = {}
	for k in t do
		table.insert(out, k)
	end
	table.sort(out)
	return out
end

local function pool(items: { string }, n: number, fn: (string) -> ())
	local queue = table.clone(items)
	local running = math.min(n, #queue)
	if running == 0 then
		return
	end
	local done = Instance.new("BindableEvent")
	for _ = 1, running do
		task.spawn(function()
			while #queue > 0 do
				local item = table.remove(queue, 1) :: string
				local ok, err = pcall(fn, item)
				if not ok then
					fails += 1
					line("FAIL", item .. ": " .. tostring(err))
				end
			end
			running -= 1
			if running == 0 then
				done:Fire()
			end
		end)
	end
	if running > 0 then
		done.Event:Wait()
	end
	done:Destroy()
end

-- Pieces per group from the table.
local groupPieces: { [string]: { string } } = {}
for name, p in PARTS do
	groupPieces[p.model] = groupPieces[p.model] or {}
	table.insert(groupPieces[p.model], name)
end

---------------------------------------------------------------------------------------------- A. raw
local t0 = os.clock()
local groups = sorted(groupPieces)
check(#groups > 0 and #sorted(ASSETS) == #groups, string.format("%d asset ids for %d groups", #sorted(ASSETS), #groups))
local fidelity: { [string]: number } = {}
local pivotRotated, pivotPosOk, pivotPosBad = 0, 0, 0
local textures: { [string]: number } = {}
local classes: { [string]: number } = {}
local innerNames: { string } = {}
local seen = 0

pool(groups, LOAD_THREADS, function(model: string)
	local id = ASSETS[model]
	if id == nil then
		check(false, model .. " has an asset id")
		return
	end
	local ok, container = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if not ok or typeof(container) ~= "Instance" then
		check(false, string.format("%s LoadAsset(%d): %s", model, id, tostring(container)))
		return
	end
	local meshes: { [string]: MeshPart } = {}
	for _, d in container:GetDescendants() do
		classes[d.ClassName] = (classes[d.ClassName] or 0) + 1
		if d:IsA("MeshPart") then
			if meshes[d.Name] then
				check(false, model .. " unique MeshPart name " .. d.Name)
			end
			meshes[d.Name] = d
		elseif d:IsA("Model") and #innerNames < 3 then
			table.insert(innerNames, d.Name)
		end
	end
	local want = groupPieces[model]
	local count = 0
	for _ in meshes do
		count += 1
	end
	check(count == #want, string.format("%s has %d MeshParts (want %d)", model, count, #want))
	for _, name in want do
		local m = meshes[name]
		local p = PARTS[name]
		if m == nil then
			check(false, name .. " found in " .. model)
			continue
		end
		seen += 1
		local err = sizeErr(m.Size, p.size)
		check(
			err <= SIZE_TOLERANCE,
			string.format(
				"%s size %.3f x %.3f x %.3f (want %g x %g x %g)",
				name,
				m.Size.X,
				m.Size.Y,
				m.Size.Z,
				p.size[1],
				p.size[2],
				p.size[3]
			)
		)
		local perr = sizeErr(m.Position, p.scene)
		check(
			perr <= POSITION_TOLERANCE,
			string.format(
				"%s centre (%.2f, %.2f, %.2f) (want %g, %g, %g)",
				name,
				m.Position.X,
				m.Position.Y,
				m.Position.Z,
				p.scene[1],
				p.scene[2],
				p.scene[3]
			)
		)
		if not isIdentity(m.CFrame) then
			line("warn", name .. " imported with a rotated CFrame " .. tostring(m.CFrame))
		end
		local f = m.CollisionFidelity.Name
		fidelity[f] = (fidelity[f] or 0) + 1
		if not isIdentity(m.PivotOffset) then
			pivotRotated += 1
		end
		local po = m.PivotOffset.Position
		if sizeErr(po, { -p.center[1], -p.center[2], -p.center[3] }) <= POSITION_TOLERANCE then
			pivotPosOk += 1
		else
			pivotPosBad += 1
			line(
				"info",
				string.format(
					"%s imported pivot at %s (manifest %g, %g, %g)",
					name,
					tostring(po),
					-p.center[1],
					-p.center[2],
					-p.center[3]
				)
			)
		end
		local tex = m.TextureID
		textures[if tex == "" then "(none)" else tex] = (textures[if tex == "" then "(none)" else tex] or 0) + 1
	end
	container:Destroy()
end)

check(
	seen == #sorted(PARTS),
	string.format("A: %d/%d pieces loaded from %d assets in %.1f s", seen, #sorted(PARTS), #groups, os.clock() - t0)
)
for _, f in sorted(fidelity) do
	line("info", string.format("A: imported CollisionFidelity %s on %d piece(s)", f, fidelity[f]))
end
line(
	"info",
	string.format(
		"A: imported PivotOffset rotated on %d piece(s); pivot position matches the manifest on %d, differs on %d",
		pivotRotated,
		pivotPosOk,
		pivotPosBad
	)
)
local texList = sorted(textures)
line("info", string.format("A: %d distinct imported TextureIDs", #texList))
for i, t in texList do
	if i <= 6 then
		line("info", string.format("A: texture %s on %d piece(s)", t, textures[t]))
	end
end
for _, c in sorted(classes) do
	line("info", string.format("A: class %s x%d", c, classes[c]))
end
line("info", "A: inner Model names e.g. " .. table.concat(innerNames, ", "))

-- Decals: what does LoadAsset return for an Open Cloud Decal upload?
for _, stem in sorted(IMAGES) do
	local ok, loaded = pcall(function()
		return InsertService:LoadAsset(IMAGES[stem])
	end)
	if ok and typeof(loaded) == "Instance" then
		local decal = loaded:FindFirstChildWhichIsA("Decal", true)
		check(
			decal ~= nil,
			string.format(
				"image %s: Decal %d -> %s",
				stem,
				IMAGES[stem],
				if decal then (decal :: Decal).Texture else "no Decal inside"
			)
		)
		loaded:Destroy()
	else
		check(false, string.format("image %s: LoadAsset(%d) %s", stem, IMAGES[stem], tostring(loaded)))
	end
end

-- Hero SurfaceAppearances: an rbxm Model asset (runtime cannot write SurfaceAppearance maps).
if APPEARANCES ~= nil then
	local ok, loaded = pcall(function()
		return InsertService:LoadAsset(APPEARANCES :: number)
	end)
	local sa = if ok and typeof(loaded) == "Instance"
		then loaded:FindFirstChildWhichIsA("SurfaceAppearance", true)
		else nil
	check(
		sa ~= nil and sa.ColorMapContent.Uri ~= "" and sa.EmissiveMaskContent.Uri ~= "",
		string.format(
			"appearances %d: %s",
			APPEARANCES :: number,
			if sa
				then sa.Name .. " colour " .. sa.ColorMapContent.Uri .. " emissive " .. sa.EmissiveMaskContent.Uri
				else tostring(loaded)
		)
	)
	if ok and typeof(loaded) == "Instance" then
		loaded:Destroy()
	end
end

---------------------------------------------------------------------------------------------- B. KitService
local server = ServerScriptService:FindFirstChild("Server")
local kitFolder = server and server:FindFirstChild("Kit")
local module = kitFolder and kitFolder:FindFirstChild("KitService")
-- A bundled copy of the current KitService can be injected here (KitLib, KitData and Config.Kit inlined) to
-- try unpublished code on an older place version; otherwise the place's own module is used.
local bundled: any = nil -- kit-bundle
if not RUN_B then
	line("info", "B: skipped (RUN_B = false)")
elseif bundled == nil and (module == nil or not module:IsA("ModuleScript")) then
	line("info", "B: skipped (this place version has no ServerScriptService.Server.Kit.KitService)")
else
	local KitService = if bundled ~= nil then bundled else require(module :: ModuleScript) :: any
	line("info", "B: KitService from " .. (if bundled ~= nil then "a bundled copy" else module:GetFullName()))
	local t1 = os.clock()
	local ready = KitService.ready(150)
	local r = KitService.report()
	line("info", "B: " .. KitService.summary())
	check(ready, string.format("B: KitService.ready() true after %.1f s", os.clock() - t1))
	for _, list in
		{ r.missing, r.sizeErrors, r.positionErrors, r.fidelityKept, r.groupsFailed, r.duplicates, r.problems }
	do
		for i, msg in list do
			if i <= 12 then
				line("warn", "B: " .. msg)
			end
		end
	end
	for _, f in sorted(r.importedFidelity) do
		line("info", string.format("B: arrived with %s: %d", f, r.importedFidelity[f]))
	end
	local atlas = KitService.atlas("Bank")
	check(atlas ~= "", "B: Bank atlas " .. atlas .. " (" .. r.atlasSource .. ")")
	for _, loc in { "CornerShop", "ToyShop" } do
		line("info", "B: atlas " .. loc .. " " .. KitService.atlas(loc))
	end
	local okPieces = 0
	for _, name in sorted(PARTS) do
		local p = PARTS[name]
		local part = KitService.clone(name)
		if part == nil then
			check(false, "B: clone " .. name)
			continue
		end
		-- Only the game's colliders keep the manifest fidelity (Config.Kit.COLLIDER_PIECES,
		-- KitLib.gameCollision); every visual-only piece is built with Box.
		local wantCollision = if GAME_COLLIDERS[name] then p.collision else "Box"
		local good = sizeErr(part.Size, p.size) <= SIZE_TOLERANCE
			and part.CollisionFidelity.Name == wantCollision
			and part.Anchored
			and part.CanCollide == p.canCollide
			and isIdentity(part.PivotOffset)
			and sizeErr(part.PivotOffset.Position, { -p.center[1], -p.center[2], -p.center[3] }) <= 1e-3
		if good then
			okPieces += 1
		else
			check(
				false,
				string.format(
					"B: %s size %s fidelity %s (want %s) anchored %s canCollide %s pivot %s",
					name,
					tostring(part.Size),
					part.CollisionFidelity.Name,
					wantCollision,
					tostring(part.Anchored),
					tostring(part.CanCollide),
					tostring(part.PivotOffset)
				)
			)
		end
		-- PivotTo puts the kit point exactly on the target.
		local target = CFrame.new(100, 5, -40) * CFrame.Angles(0, math.rad(90), 0)
		part:PivotTo(target)
		if (part:GetPivot().Position - target.Position).Magnitude > 1e-3 then
			check(false, "B: " .. name .. " PivotTo lands on the target")
		end
		part:Destroy()
	end
	check(
		okPieces == #sorted(PARTS),
		string.format("B: %d/%d clones match size, fidelity, flags and pivot", okPieces, #sorted(PARTS))
	)
	local okModels = 0
	for _, model in groups do
		local m = KitService.cloneModel(model, { atlas = "CornerShop" })
		local count = 0
		if m then
			for _, d in m:GetDescendants() do
				if d:IsA("MeshPart") then
					count += 1
				end
			end
			if count == #groupPieces[model] and m.WorldPivot == CFrame.identity then
				okModels += 1
			else
				check(
					false,
					string.format(
						"B: model %s has %d pieces (want %d), pivot %s",
						model,
						count,
						#groupPieces[model],
						tostring(m.WorldPivot)
					)
				)
			end
			m:Destroy()
		else
			check(false, "B: cloneModel " .. model)
		end
	end
	check(okModels == #groups, string.format("B: %d/%d group models clone whole", okModels, #groups))
	local face = KitService.clone("VaultDoor_DialFace")
	if face then
		local sa = face:FindFirstChildOfClass("SurfaceAppearance")
		local what = if sa then "SurfaceAppearance " .. sa.ColorMapContent.Uri else "TextureID " .. face.TextureID
		if APPEARANCES ~= nil then
			check(sa ~= nil and face.TextureID == "", "B: VaultDoor_DialFace wears the uploaded " .. what)
		else
			line("info", "B: VaultDoor_DialFace " .. what)
		end
		face:Destroy()
	end
end

line("info", string.format("%d check(s) failed", fails))
return table.concat(lines, "\n")
