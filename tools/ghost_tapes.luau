-- Generates src/shared/Heist/GhostTapes.luau: the "Show me?" chalk ghost's steps (PLAN_STEAM_PLUS
-- §5 "Stuck", §6.1 item 5; WALKTHROUGH P0-2). For every story level after L1 it plays the level's
-- solution (tests/sim/Solutions, the PLACEHOLDER scripted runs until the owner records
-- levels/<id>.solution.bin) with the sim harness and writes, per run of the solution:
--   * the recording in the wire format (Rec/Codec), base64: what the ghost walks;
--   * the run's goal: the plate its clone ends on and when it got there ({plate, at}), or the
--     final run's bank ({bank = true}). Shared/Heist/Help.nextStep compares these goals with the
--     player's deck to pick the ONE next step the ghost shows.
--   lune run tools/ghost_tapes.luau            write the module
--   lune run tools/ghost_tapes.luau --check    exit 1 if the module is out of date
-- tests/sim/GhostTapes.spec.luau checks freshness byte for byte, like StagingTapes.

local fs = require("@lune/fs")
local process = require("@lune/process")

local Codec = require("../src/shared/Rec/Codec")
local Geom = require("../src/shared/Sim/Geom")
local Harness = require("../tests/sim/Harness")
local Solutions = require("../tests/sim/Solutions")

local OUT = "src/shared/Heist/GhostTapes.luau"
local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
-- Story levels after the L1 tutorial (design numbers; the Clone Party has no steps to show).
local LEVELS = { 2, 3, 4, 6 }

local function base64(buf: buffer): string
	local out = {}
	local n = buffer.len(buf)
	local i = 0
	while i < n do
		local b0 = buffer.readu8(buf, i)
		local b1 = if i + 1 < n then buffer.readu8(buf, i + 1) else 0
		local b2 = if i + 2 < n then buffer.readu8(buf, i + 2) else 0
		local v = b0 * 65536 + b1 * 256 + b2
		for k = 0, 3 do
			local idx = bit32.band(bit32.rshift(v, 18 - 6 * k), 63) + 1
			if i + k - 1 >= n then
				table.insert(out, "=")
			else
				table.insert(out, string.sub(ALPHABET, idx, idx))
			end
		end
		i += 3
	end
	return table.concat(out)
end

-- The plate a recording ends on and the loop time its clone got there (start of the last stretch
-- of samples inside the plate box).
local function endPlate(level: any, rec: any): (string?, number?)
	local n = rec.n
	if n == 0 then
		return nil, nil
	end
	for _, p in level.plates do
		if Geom.contains(p.box, rec.px[n], rec.py[n], rec.pz[n]) then
			local k = n
			while k > 1 and Geom.contains(p.box, rec.px[k - 1], rec.py[k - 1], rec.pz[k - 1]) do
				k -= 1
			end
			return p.id, (k - 1) / rec.hz
		end
	end
	return nil, nil
end

local lines = {
	"--!strict",
	'-- GENERATED by `lune run tools/ghost_tapes.luau`: do not edit. The "Show me?" chalk ghost\'s',
	'-- steps (PLAN_STEAM_PLUS §5 "Stuck", WALKTHROUGH P0-2): each story level\'s solution',
	"-- (tests/sim/Solutions, PLACEHOLDER scripted runs until the owner's recordings land) as one",
	"-- Rec/Codec buffer per run, base64, with the run's goal: the plate its clone ends on and when it",
	"-- got there (`at`, loop seconds), or `bank` for the final run. Shared/Heist/Help.nextStep picks",
	"-- the next step from these goals and the player's deck. Pure data (client, server and Lune).",
	"-- `lune run tools/ghost_tapes.luau --check` tells when it is stale (tests/sim/GhostTapes.spec).",
	"",
	"local GhostTapes = {}",
	"",
	"export type Step = { plate: string?, at: number?, bank: boolean?, tape: string }",
	"",
	"GhostTapes.LEVELS = {",
}

local total = 0
for _, n in LEVELS do
	local level = Harness.level(n)
	local plan = Solutions.planFor(level)
	local sim = Harness.play(level, plan)
	assert(sim.overReason == "Complete", level.id .. ": the solution must complete")
	-- The deck holds the plate runs; the final (banking) run is the heist's last recording.
	local slots = table.clone(sim.players[1].deck.slots)
	if #slots == #plan.runs - 1 then
		table.insert(slots, { rec = sim.finalRecordings[1].rec })
	end
	assert(#slots == #plan.runs, level.id .. ": one recording per solution run")
	table.insert(lines, string.format("\t%s = {", level.id))
	for r, slot in slots do
		local tape = base64(Codec.encode(slot.rec))
		total += #tape
		local plate, at = endPlate(level, slot.rec)
		if r == #slots then
			assert(plate == nil, level.id .. ": the last run banks")
			-- One field per line: the layout StyLua gives (the tapes are long).
			for _, l in { "\t\t{", "\t\t\tbank = true,", string.format("\t\t\ttape = %q,", tape), "\t\t}," } do
				table.insert(lines, l)
			end
		else
			assert(plate ~= nil and at ~= nil, level.id .. ": run " .. r .. " ends on a plate")
			for _, l in
				{
					"\t\t{",
					string.format("\t\t\tplate = %q,", plate),
					string.format("\t\t\tat = %.2f,", at),
					string.format("\t\t\ttape = %q,", tape),
					"\t\t},",
				}
			do
				table.insert(lines, l)
			end
		end
	end
	table.insert(lines, "\t},")
end

for _, line in
	{
		"} :: { [string]: { Step } }",
		"",
		"local ALPHABET = " .. string.format("%q", ALPHABET),
		"local INDEX: { [string]: number } = {}",
		"for i = 1, #ALPHABET do",
		"\tINDEX[string.sub(ALPHABET, i, i)] = i - 1",
		"end",
		"",
		"-- Base64 text -> buffer (the generator writes valid text).",
		"function GhostTapes.decode64(text: string): buffer",
		'\tlocal pad = #(string.match(text, "=*$") or "")',
		"\tlocal n = #text // 4 * 3 - pad",
		"\tlocal buf = buffer.create(n)",
		"\tlocal o = 0",
		"\tfor i = 1, #text, 4 do",
		"\t\tlocal v = 0",
		"\t\tfor k = 0, 3 do",
		"\t\t\tv = v * 64 + (INDEX[string.sub(text, i + k, i + k)] or 0)",
		"\t\tend",
		"\t\tfor k = 2, 0, -1 do",
		"\t\t\tif o < n then",
		"\t\t\t\tbuffer.writeu8(buf, o, bit32.band(bit32.rshift(v, 8 * k), 255))",
		"\t\t\t\to += 1",
		"\t\t\tend",
		"\t\tend",
		"\tend",
		"\treturn buf",
		"end",
		"",
		"-- The steps of a level (nil: no ghost for it).",
		"function GhostTapes.steps(levelId: string): { Step }?",
		"\treturn GhostTapes.LEVELS[levelId]",
		"end",
		"",
		"-- Step k's recording as a buffer (Rec/Codec.decode it).",
		"function GhostTapes.buffer(levelId: string, k: number): buffer?",
		"\tlocal steps = GhostTapes.LEVELS[levelId]",
		"\tlocal step = steps and steps[k]",
		"\treturn if step then GhostTapes.decode64(step.tape) else nil",
		"end",
		"",
		"return GhostTapes",
		"",
	}
do
	table.insert(lines, line)
end
local text = table.concat(lines, "\n")

if table.find(process.args, "--check") then
	local current = if fs.isFile(OUT) then fs.readFile(OUT) else ""
	if current ~= text then
		print(OUT .. " is out of date: run `lune run tools/ghost_tapes.luau`")
		process.exit(1)
	end
	print(OUT .. " is up to date")
	process.exit(0)
end
fs.writeFile(OUT, text)
print(string.format("wrote %s (%d levels, %d bytes of tapes, %d bytes)", OUT, #LEVELS, total, #text))
