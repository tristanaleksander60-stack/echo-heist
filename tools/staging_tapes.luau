-- Generates src/server/Heist/StagingTapes.luau: the G2 / CLONE_AB golden-frame clones
-- (docs/GOLDEN_FRAMES.md "Capture", Shared/Heist/Scenario). It plays the Clone Party's
-- solution (tests/sim/Solutions.cs5_clone_party, the PLACEHOLDER scripted runs until the owner
-- records levels/cs5_clone_party.solution.bin) for Scenario.TAPES runs with the sim harness,
-- and writes the deck's recordings in the wire format (Rec/Codec), base64 encoded. The Studio
-- server seeds them into your deck before run 1 (HeistSim.seedDeck), so you + 7 = "8 OF ME".
--   lune run tools/staging_tapes.luau            write the module
--   lune run tools/staging_tapes.luau --check    exit 1 if the module is out of date

local fs = require("@lune/fs")
local process = require("@lune/process")

local Codec = require("../src/shared/Rec/Codec")
local Scenario = require("../src/shared/Heist/Scenario")
local Harness = require("../tests/sim/Harness")
local Solutions = require("../tests/sim/Solutions")

local OUT = "src/server/Heist/StagingTapes.luau"
local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function base64(buf: buffer): string
	local out = {}
	local n = buffer.len(buf)
	local i = 0
	while i < n do
		local b0 = buffer.readu8(buf, i)
		local b1 = if i + 1 < n then buffer.readu8(buf, i + 1) else 0
		local b2 = if i + 2 < n then buffer.readu8(buf, i + 2) else 0
		local v = b0 * 65536 + b1 * 256 + b2
		for k = 0, 3 do
			local idx = bit32.band(bit32.rshift(v, 18 - 6 * k), 63) + 1
			if i + k - 1 >= n then
				table.insert(out, "=")
			else
				table.insert(out, string.sub(ALPHABET, idx, idx))
			end
		end
		i += 3
	end
	return table.concat(out)
end

local level = Harness.level(5)
local plan = Solutions.planFor(level)
local runs = {}
for r = 1, Scenario.TAPES do
	runs[r] = plan.runs[r]
end
local sim = Harness.play(level, { runs = runs })
local slots = sim.players[1].deck.slots
assert(#slots == Scenario.TAPES, `expected {Scenario.TAPES} recordings, got {#slots}`)

local lines = {
	"--!strict",
	"-- GENERATED by `lune run tools/staging_tapes.luau`: do not edit. The G2 / CLONE_AB golden-frame",
	"-- clones (Shared/Heist/Scenario): the Clone Party solution's first " .. Scenario.TAPES .. " runs",
	"-- (tests/sim/Solutions.cs5_clone_party) as Rec/Codec buffers, base64. Server-only, Studio-only",
	"-- (Heist/Staging); `lune run tools/staging_tapes.luau --check` tells when they are stale.",
	"",
	"local StagingTapes = {}",
	"",
	string.format("StagingTapes.LEVEL = %q", level.id),
	"StagingTapes.TAPES = {",
}
for _, slot in slots do
	table.insert(lines, string.format("\t%q,", base64(Codec.encode(slot.rec))))
end
for _, line in
	{
		"}",
		"",
		"local ALPHABET = " .. string.format("%q", ALPHABET),
		"",
		"-- Base64 text -> buffer (no padding errors: the generator writes it).",
		"function StagingTapes.decode64(text: string): buffer",
		"\tlocal index: { [string]: number } = {}",
		"\tfor i = 1, #ALPHABET do",
		"\t\tindex[string.sub(ALPHABET, i, i)] = i - 1",
		"\tend",
		'\tlocal pad = #(string.match(text, "=*$") or "")',
		"\tlocal n = #text // 4 * 3 - pad",
		"\tlocal buf = buffer.create(n)",
		"\tlocal o = 0",
		"\tfor i = 1, #text, 4 do",
		"\t\tlocal v = 0",
		"\t\tfor k = 0, 3 do",
		"\t\t\tv = v * 64 + (index[string.sub(text, i + k, i + k)] or 0)",
		"\t\tend",
		"\t\tfor k = 2, 0, -1 do",
		"\t\t\tif o < n then",
		"\t\t\t\tbuffer.writeu8(buf, o, bit32.band(bit32.rshift(v, 8 * k), 255))",
		"\t\t\t\to += 1",
		"\t\t\tend",
		"\t\tend",
		"\tend",
		"\treturn buf",
		"end",
		"",
		"-- The recordings as buffers (Codec.decode each to seed a deck).",
		"function StagingTapes.buffers(): { buffer }",
		"\tlocal out = {}",
		"\tfor i, text in StagingTapes.TAPES do",
		"\t\tout[i] = StagingTapes.decode64(text)",
		"\tend",
		"\treturn out",
		"end",
		"",
		"return StagingTapes",
		"",
	}
do
	table.insert(lines, line)
end
local text = table.concat(lines, "\n")

if table.find(process.args, "--check") then
	local current = if fs.isFile(OUT) then fs.readFile(OUT) else ""
	if current ~= text then
		print(OUT .. " is out of date: run `lune run tools/staging_tapes.luau`")
		process.exit(1)
	end
	print(OUT .. " is up to date")
	process.exit(0)
end
fs.writeFile(OUT, text)
print(string.format("wrote %s (%d recordings, %d bytes)", OUT, #slots, #text))
